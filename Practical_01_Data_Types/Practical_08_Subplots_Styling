8. Set

s = {10, 20, 30, 40, 50}
print("\nSet:", s)
print("Type:", type(s))
print("Length:", len(s))

s.add(60)
print("After adding 60:", s)

s.remove(20)
print("After removing 20:", s)

Set operations

s1 = {1, 2, 3, 4}
s2 = {3, 4, 5, 6}

print("\nSet 1:", s1)
print("Set 2:", s2)
print("Union:", s1.union(s2))
print("Intersection:", s1.intersection(s2))
print("Difference:", s1.difference(s2))
